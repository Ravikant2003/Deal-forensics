# Deal Forensics AI — Environment Variables
# Copy this file to .env and fill in your values

# ── LLM Provider ────────────────────────────────────────────────────────────────
# Options: "ollama" (local, free) or "groq" (cloud)
# Using Ollama requires local models running (ollama list)
LLM_PROVIDER=ollama

# Required for Groq (get free key at https://console.groq.com)
# GROQ_API_KEY=your_groq_api_key_here

# ── Ollama Settings ────────────────────────────────────────────────────────────
# Model to use (must be running via 'ollama serve')
# Options: mistral, qwen2.5-coder:7b-instruct, llama3, etc.
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434
